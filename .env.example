# Telegram bot: create via @BotFather, then /setprivacy -> Disable so the
# bot sees every message in a topic, not just @-mentions.
TELEGRAM_BOT_TOKEN=

# The group chat_id (negative number) and your own numeric user_id. The
# bridge only ever acts on messages from this exact (chat, user) pair --
# find both by sending one message in any topic and checking
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=

# zcode runtime (see README.md for how this was obtained/installed)
ZCODE_NODE_BIN=
ZCODE_BIN=
ZCODE_WORKSPACE_DIR=

# Model used for newly-created topic sessions. Switch anytime with
# ZCODE_DEFAULT_MODEL=zai/glm-5.2 (or glm-5.3-flash).
ZCODE_DEFAULT_MODEL=zai/glm-5.3

# yolo = auto-approve at the session level. AUTO_APPROVE_PERMISSIONS is a
# second, independent safety net: if an interaction/requestPermission still
# arrives despite yolo mode, it's auto-approved with a non-blocking notice
# posted to the topic. Set to false to fall back to interactive
# Approve/Deny inline-keyboard prompts instead.
ZCODE_DEFAULT_MODE=yolo
AUTO_APPROVE_PERMISSIONS=true

# How long an interactive permission prompt waits before auto-denying
# (only relevant when AUTO_APPROVE_PERMISSIONS=false).
PERMISSION_TIMEOUT_MS=600000

# Streaming: the reply-to-be lands on the turn's placeholder message and is
# edited in place, at most once per this interval (the 20 msg/min group cap
# is not a constraint; this is the agreed pacing rule).
STREAM_EDIT_INTERVAL_MS=5000

# How often the placeholder's elapsed-time counter gets nudged even with NO
# new content, so one long tool call (a VM boot, a slow test run, ...) can't
# freeze it for the whole stretch and make a genuinely-running turn look
# dead. 0 disables the pulse (old behavior: only real events cause an edit).
STREAM_HEARTBEAT_MS=60000

# How long a posted model question (AskUserQuestion -> inline buttons) waits
# for a tap before being auto-declined so the turn keeps moving.
USER_INPUT_TIMEOUT_MS=600000

# /file upload cap in MB (Telegram bots accept up to 50).
MAX_FILE_MB=45

# Inbound (user-sent) document cap in MB; 20 is Telegram's hard bot download
# limit, so anything larger can sit in chat but never be fetched.
MAX_INBOUND_FILE_MB=20

# Turn-timeout watchdog. DISABLED by default: the old
# 20-minute default killed real, merely-slow turns; /stop is the designated
# escape hatch for a wedged topic. Set a duration (ms) to re-arm the sweep.
TURN_TIMEOUT_MS=0

# How long a redeploy (SIGTERM/SIGINT) waits for in-flight turns to finish
# naturally before falling back to interrupt-and-notify. While draining, new
# messages are queued (with an explanatory notice) instead of starting a
# fresh turn -- the bridge stays responsive throughout, it just stops
# admitting new work. Set to 0 to skip draining and restart immediately
# (the old behavior: every in-flight turn gets interrupted right away).
SHUTDOWN_DRAIN_MS=1500000

# Testing seam: point at a local fake Telegram to run test/e2e.mjs against
# the whole bridge without touching the live bot. Leave unset in production.
#TELEGRAM_API_ROOT=

# Where the topic<->session store (data/sessions.json by default) and its
# lock file live. Only relevant if you need multiple independent bridge
# deployments on one host -- each needs its own STORE_PATH.
STORE_PATH=
