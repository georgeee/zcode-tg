# zcode-tg bridge — systemd --user unit TEMPLATE.
#
# The repo copy is not what systemd reads. To deploy: copy this file to
# ~/.config/systemd/user/zcode-bridge.service, adjust the three paths below
# (WorkingDirectory, ExecStart's node, and the log paths) to your checkout
# and Node binary, then:
#   systemctl --user daemon-reload && systemctl --user enable --now zcode-bridge.service
#
# %h expands to the home directory of the user running the unit, so the
# defaults below work for a checkout at ~/zcode-tg with node on PATH.

[Unit]
Description=zcode <-> Telegram bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/zcode-tg
# /usr/bin/env because systemd requires an absolute path for the first
# ExecStart token; swap for your node's absolute path if you don't want to
# depend on PATH (e.g. a toolchain node in a nonstandard location).
ExecStart=/usr/bin/env node bridge/index.js
Restart=always
RestartSec=3
# bridge/index.js's shutdown() drains in-flight turns for up to
# SHUTDOWN_DRAIN_MS (default 25 min, see .env.example) before it actually
# exits on SIGTERM. systemd's own default TimeoutStopSec (~90s) would
# SIGKILL it well before that window closes, cutting a turn off harder than
# the thing this was built to avoid -- so this must stay comfortably above
# the drain default. 30 min leaves 5 min of slack for the notify-and-kill
# fallback and process teardown after the drain window elapses.
TimeoutStopSec=1800
# KillMode=mixed is what makes the drain above POSSIBLE at all: the default
# control-group mode SIGTERMs every process in the cgroup simultaneously,
# which kills the zcode app-server child (and with it the in-flight turn the
# bridge is draining) at the same instant the bridge receives its own
# SIGTERM. With mixed, only the main process gets SIGTERM; the child stays
# alive until the bridge stops it itself after draining, and everything else
# is SIGKILLed only if the TimeoutStopSec above elapses.
KillMode=mixed
StandardOutput=append:%h/zcode-tg/data/bridge.log
StandardError=append:%h/zcode-tg/data/bridge.log

# Kernel/process-level hardening -- deliberately NOT ProtectHome or
# ProtectSystem=strict (zcode needs unrestricted read/write access to
# ZCODE_WORKSPACE_DIR by design -- that's its whole job), NOT
# RestrictNamespaces or LockPersonality (would break legitimate,
# in-scope agent work like container-based dev/test or gdb debugging,
# which run as descendants of this same unit), and NOT
# MemoryDenyWriteExecute (has a history of friction with V8/Node JIT on
# some kernel+systemd combinations -- needs isolated testing against this
# exact Node build before adopting, not blanket-enabled).
#
# The mount-namespace-based directives (PrivateTmp, ProtectClock,
# ProtectHostname, ProtectKernelLogs, ProtectKernelModules,
# ProtectKernelTunables, ProtectControlGroups) were tried and REMOVED:
# under an unprivileged `systemctl --user` manager they can fail the whole
# service with exit status 218/CAPABILITIES -- creating those namespaces
# needs privileges a user session manager may not have. Confirmed
# empirically on at least one host; don't re-add without testing on the
# target host first. What's left is prctl/seccomp-based, not
# namespace-based, and does start cleanly under --user there.
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictRealtime=true

[Install]
WantedBy=default.target
